# Copy to .env and adjust for your environment.
APP_NAME=Campaign Management Platform
ENV=local
DEBUG=true

# IMPORTANT: generate a long random value in production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-please-use-a-long-random-string

DATABASE_URL=sqlite:///campaign.db

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-free JSON array; default allows the Vite dev server.
# CORS_ORIGINS=["http://localhost:5173"]

ENABLE_SCHEDULER=true
SCHEDULER_POLL_SECONDS=15
EXECUTION_BATCH_SIZE=500
BASE_URL=http://localhost:8000
