# Copy to .env (or just export) to change the port. Default is 8002.
PORT=8002

# --- Authentication ---
# Set to false to run the API completely open (no API key / JWT required)
AUTH_ENABLED=true
# API Key clients send in the "X-API-Key" header
API_KEY=my-secret-api-key
# Secret used to sign/verify JWTs
JWT_SECRET=my-super-secret-jwt-key-change-me
JWT_EXP_SECONDS=3600
# Demo credentials accepted by POST /auth/login
AUTH_USER=admin
AUTH_PASS=password
