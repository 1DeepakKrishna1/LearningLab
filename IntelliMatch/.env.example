# SentenceTransformer model used for the semantic nearest-key fallback.
EMBED_MODEL=all-MiniLM-L6-v2

# Minimum cosine similarity (0.0-1.0) required to accept a semantic match.
SIMILARITY_THRESHOLD=0.80

# Enable the semantic nearest-key fallback for rows with no exact match.
# Accepts: true/false, 1/0, yes/no, on/off
USE_SEMANTIC_SEARCH=true
