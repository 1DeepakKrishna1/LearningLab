# Copy this file to .env and fill in your values. Do NOT commit your real .env.

# Default provider when executing a prompt: openai or gemini.
# (You can also just pick at runtime; this only sets the default.)
LLM_PROVIDER=openai

# --- OpenAI ---
# Required to execute with OpenAI.
OPENAI_API_KEY=sk-your-key-here
# Optional: model to use (defaults to gpt-4o-mini if unset).
OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini ---
# Required to execute with Gemini (GOOGLE_API_KEY also accepted).
GEMINI_API_KEY=your-gemini-key-here
# Optional: model to use (defaults to gemini-2.0-flash if unset).
GEMINI_MODEL=gemini-2.0-flash
