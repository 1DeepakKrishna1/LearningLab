REDIS_URL=redis://localhost:6379/0
KEY_PREFIX=semcache
HIGH_TH=0.9
LOW_TH=0.7
TOP_K=5
DEFAULT_TTL=3600

# ── Embedder backend ──────────────────────────────────────────────────
# "demo" (default, hash-based, no download) or "hf" (real semantic model)
EMBEDDER=demo

# ── Embeddings (HuggingFace — runs locally, no API key needed) ────────
HF_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DIM=384

# ── LLM backend ───────────────────────────────────────────────────────
# "mock" (default, no API key) or "groq" (requires GROQ_API_KEY below)
LLM_BACKEND=mock

# ── LLM (Groq) ────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=1024
