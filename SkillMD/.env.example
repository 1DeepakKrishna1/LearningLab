# Copy to .env and fill in. Loaded automatically by router.py.
# Real shell environment variables take precedence over this file.

# Which router to use: openai | gemini | keyword | auto
SKILL_ROUTER=auto

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini (GOOGLE_API_KEY is also accepted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
