# Copy to .env and fill in. Only OPENAI_API_KEY is required.

# --- LLM (OpenAI) ---
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
# Optional: point at a compatible gateway / Azure-style base URL
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Embeddings (OpenAI) ---
EMBEDDING_MODEL=text-embedding-3-small

# --- Uploads ---
MAX_UPLOAD_MB=100
MAX_UPLOAD_FILES=30
# Scanned PDFs (no text layer) are OCR'd via the vision model, page by page.
PDF_OCR_MAX_PAGES=30
PDF_OCR_DPI=150

# --- Crawler ---
MAX_CRAWL_DEPTH=2
MAX_PAGES=200
CRAWL_CONCURRENCY=8
REQUEST_TIMEOUT=20
SAME_DOMAIN_ONLY=true
RESPECT_ROBOTS=true
USER_AGENT=KnowledgePortalBot/1.0 (+https://example.com)

# --- RAG ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=6

# --- Storage / server ---
DATA_DIR=./data
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
