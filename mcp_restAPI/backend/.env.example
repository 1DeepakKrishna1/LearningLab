# Copy to .env and fill in.

# --- LLM (OpenAI) ---
OPENAI_API_KEY=sk-...
# Chat/reasoning model used by the agent.
OPENAI_MODEL=gpt-4o
# Optional: override the OpenAI base URL (e.g. Azure OpenAI / proxy).
# OPENAI_BASE_URL=

# --- Agent behaviour ---
# Max tool-calling iterations per user turn before the agent must answer.
AGENT_MAX_STEPS=12
# HTTP methods that require explicit human approval before execution.
APPROVAL_REQUIRED_METHODS=POST,PUT,PATCH,DELETE

# --- Server ---
# Comma-separated list of allowed CORS origins for the React frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Outbound REST call timeout (seconds).
HTTP_TIMEOUT=30
