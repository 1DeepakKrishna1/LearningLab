# ---------------------------------------------------------------------------
# ClawFlow backend configuration. Copy to `.env` and adjust.
# Every value has a sensible default in app/config.py; nothing here is mandatory
# except an LLM key if you want the agent runtime / AI builder to actually call a model.
# ---------------------------------------------------------------------------

# --- App ---
CLAWFLOW_APP_NAME=ClawFlow
CLAWFLOW_ENV=development
CLAWFLOW_HOST=0.0.0.0
CLAWFLOW_PORT=8000
CLAWFLOW_LOG_LEVEL=INFO
CLAWFLOW_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Storage ---
# Where the JSON data files live. Created on first run.
CLAWFLOW_DATA_DIR=./data
CLAWFLOW_STORAGE_BACKEND=json

# --- Tool library (existing agents-tools-library) ---
# Absolute path to the `library` package root that contains tools/.
CLAWFLOW_TOOL_LIBRARY_PATH=../../agents_tools_library/library
# Python import root that makes `library.tools.<cat>.<tool>.tool` importable.
CLAWFLOW_TOOL_LIBRARY_PYTHONPATH=../../agents_tools_library

# --- Security ---
CLAWFLOW_JWT_SECRET=change-me-in-production-please
CLAWFLOW_JWT_ALGORITHM=HS256
CLAWFLOW_JWT_EXPIRE_MINUTES=720
# First-run seeded admin account.
CLAWFLOW_BOOTSTRAP_ADMIN_EMAIL=admin@clawflow.local
CLAWFLOW_BOOTSTRAP_ADMIN_PASSWORD=admin123

# --- Agent runtime / LLM ---
# Provider: anthropic | openai | google | ollama | groq
CLAWFLOW_DEFAULT_LLM_PROVIDER=anthropic
CLAWFLOW_DEFAULT_LLM_MODEL=claude-sonnet-4-6
# Provide a key for whichever provider you choose above.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# --- Groq (e.g. set PROVIDER=groq and MODEL=llama-3.3-70b-versatile above) ---
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile   # used if CLAWFLOW_DEFAULT_LLM_MODEL is unset

# --- Engine ---
CLAWFLOW_MAX_PARALLEL_NODES=8
CLAWFLOW_DEFAULT_NODE_TIMEOUT=300
CLAWFLOW_DEFAULT_MAX_RETRIES=2

# --- Messaging / WhatsApp ---
# console | meta | twilio
CLAWFLOW_MESSAGING_PROVIDER=console
# META_WHATSAPP_TOKEN=...
# META_PHONE_NUMBER_ID=...
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
