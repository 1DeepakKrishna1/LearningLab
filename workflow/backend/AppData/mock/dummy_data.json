    {
      "id": "agent-010",
      "name": "Prompt Agent",
      "description": "Executes parameterized System + User prompt templates against an LLM with variable injection",
      "type": "prompt_agent",
      "tools": [
        "tool-006",
        "tool-011"
      ],
      "tool_configs": {},
      "properties": {
        "system_prompt": "You are an expert {{domain}} analyst with deep knowledge of {{context}}.\n\nRespond in {{output_format}} format.\nBe concise, accurate, and data-driven.\nIf data is missing, clearly state assumptions.\nCurrent date: {{timestamp}}.",
        "user_prompt": "Input data:\n{{input_data}}\n\nTask: {{task}}\n\nProvide:\n1. A concise summary\n2. Key insights from the data\n3. Anomalies or risks detected\n4. Recommended next steps",
        "model": "llama-3.3-70b-versatile",
        "temperature": 0.7,
        "max_tokens": 2000,
        "output_format": "markdown"
      },
      "icon": "message-circle",
      "color": "#ec4899",
      "review_status": "approved",
      "invoke": {
        "input_parameters": [],
        "output_parameters": []
      }
    },
    {
      "id": "agent-011",
      "name": "ReAct Agent",
      "description": "Iteratively Reasons and Acts using tools until a final answer is reached (ReAct pattern)",
      "type": "react_agent",
      "tools": [
        "tool-006",
        "tool-013",
        "tool-011"
      ],
      "tool_configs": {},
      "properties": {
        "goal_prompt": "Goal: {{user_query}}\n\nAvailable context:\n{{context}}\n\nInstructions:\n- Think step-by-step before each action\n- Use Web Search to find recent information\n- Use REST API Caller for structured data retrieval\n- Cite your sources in the final answer\n- Stop reasoning when you reach a confident answer\n- Format final answer as: {{output_format}}",
        "max_iterations": 6,
        "model": "llama-3.3-70b-versatile",
        "stop_on_answer": true,
        "trace_thoughts": true
      },
      "icon": "repeat",
      "color": "#06b6d4",
      "review_status": "approved",
      "invoke": {
        "input_parameters": [],
        "output_parameters": []
      }
    },
    {
      "id": "agent-012",
      "name": "Reflection Agent",
      "description": "Generates an initial output, self-critiques it and iteratively improves until quality threshold is met",
      "type": "reflection_agent",
      "tools": [
        "tool-006"
      ],
      "tool_configs": {},
      "properties": {
        "critique_prompt": "Review the following response:\n---\n{{previous_output}}\n---\n\nEvaluate on three dimensions:\n1. Accuracy \u2014 Is every factual claim correct? (1\u201310)\n2. Completeness \u2014 Does it fully address the original task? (1\u201310)\n3. Clarity \u2014 Is it well-structured and easy to understand? (1\u201310)\n\nProvide:\n- An overall score (average of the three)\n- Specific weaknesses found\n- Concrete, actionable improvements\n- A revised version if score < {{quality_threshold}}",
        "quality_threshold": 8.0,
        "max_iterations": 3,
        "model": "llama-3.3-70b-versatile",
        "temperature": 0.4
      },
      "icon": "refresh-cw",
      "color": "#14b8a6",
      "review_status": "approved",
      "invoke": {
        "input_parameters": [],
        "output_parameters": []
      }
