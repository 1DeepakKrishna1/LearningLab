      "id": "tpl-004",
      "name": "ReAct Research Agent",
      "description": "A ReAct loop agent reasons and acts using Web Search and REST API tools, with guardrails on input/output and reflection-based improvement of the final answer.",
      "status": "active",
      "nodes": [
        {
          "id": "ra-n1",
          "node_kind": "agent",
          "agent_id": "agent-013",
          "tool_id": null,
          "position": {
