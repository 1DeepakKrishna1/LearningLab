      "id": "tpl-006",
      "name": "Supervised Multi-Agent Workflow",
      "description": "A Supervisor monitors the pipeline; an Orchestrator decomposes the task; parallel Prompt and ReAct sub-agents handle sub-tasks; Reflection merges results; Guardrails validates before delivery.",
      "status": "active",
      "nodes": [
        {
          "id": "sm-n1",
          "node_kind": "agent",
