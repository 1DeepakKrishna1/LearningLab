          "tool_id": null,
          "position": {
            "x": 800.0,
            "y": 250.0
          },
          "data": {
            "name": "Reflect & Merge",
            "type": "reflection_agent",
            "properties": {
              "critique_prompt": "Merge and review these sub-agent outputs:\n\nSub-Agent A result:\n{{previous_output}}\n\nEvaluate the merged result for:\n1. Consistency \u2014 Do the results agree? (1\u201310)\n2. Coverage \u2014 Is {{task}} fully addressed? (1\u201310)\n3. Quality \u2014 Is the output actionable? (1\u201310)\n\nProvide a unified, coherent final output. If score < {{quality_threshold}}, revise.",
              "quality_threshold": 7.5,
