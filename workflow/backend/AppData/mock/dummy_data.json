          "position": {
            "x": 560.0,
            "y": 400.0
          },
          "data": {
            "name": "ReAct Sub-Agent",
            "type": "react_agent",
            "properties": {
              "goal_prompt": "Sub-task: {{task}}\n\nInput data: {{input_data}}\n\nUse Web Search and REST API to enrich the data with current information. Reason step-by-step. Output: {{output_format}}",
              "max_iterations": 4,
              "model": "llama-3.3-70b-versatile",
              "stop_on_answer": true,
              "trace_thoughts": true
            }
          }
        },
