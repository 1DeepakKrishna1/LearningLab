          "position": {
            "x": 320.0,
            "y": 200.0
          },
          "data": {
            "name": "ReAct Research",
            "type": "react_agent",
            "properties": {
              "goal_prompt": "Goal: {{user_query}}\n\nContext: {{context}}\n\nInstructions:\n- Think step-by-step before each action\n- Use Web Search for recent facts and current events\n- Use REST API Caller for structured data retrieval\n- Cite all sources\n- Output format: {{output_format}}",
              "max_iterations": 6,
              "model": "llama-3.3-70b-versatile",
              "stop_on_answer": true,
              "trace_thoughts": true
            }
          }
        },
        {
          "id": "ra-n3",
          "node_kind": "agent",
          "agent_id": "agent-012",
          "tool_id": null,
          "position": {
            "x": 560.0,
            "y": 200.0
          },
          "data": {
            "name": "Reflect & Improve",
            "type": "reflection_agent",
            "properties": {
              "critique_prompt": "Review this research answer:\n---\n{{previous_output}}\n---\n\nScore on:\n1. Factual accuracy (1\u201310)\n2. Source coverage (1\u201310)\n3. Answer completeness (1\u201310)\n\nIf overall < {{quality_threshold}}, provide an improved version.",
