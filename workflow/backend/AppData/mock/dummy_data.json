              "system_prompt": "You are an expert at {{domain}}. Your sub-task: {{task}}\n\nContext from orchestrator:\n{{context}}\n\nRespond in {{output_format}} format. Be thorough but concise.",
              "user_prompt": "Process this input:\n{{input_data}}\n\nFocus on: structured analysis, key findings, data integrity issues.",
              "model": "llama-3.3-70b-versatile",
              "temperature": 0.5,
              "max_tokens": 1500,
              "output_format": "json"
