{
  "tools": [
    {
      "id": "tool-L01",
      "name": "Legal Database Search",
      "description": "Search Indian and international legal databases such as SCC, Manupatra, Westlaw, and LexisNexis",
      "type": "legal_search",
      "properties": {
        "sources": ["SCC", "Manupatra", "Westlaw", "LexisNexis"],
        "max_results": 20
      },
      "icon": "search"
    },
    {
      "id": "tool-L02",
      "name": "Judgment Analyzer",
      "description": "Analyze court judgments and extract legal principles, ratio decidendi and precedents",
      "type": "ai_model",
      "properties": {
        "model": "legal-llm",
        "max_tokens": 2000
      },
      "icon": "scale"
    },
    {
      "id": "tool-L03",
      "name": "Legal Document Generator",
      "description": "Generate legal drafts such as contracts, agreements, legal notices",
      "type": "ai_model",
      "properties": {
        "document_types": [
          "Contract",
          "Agreement",
          "Legal Notice",
          "Policy Draft"
        ]
      },
      "icon": "file-text"
    },
    {
      "id": "tool-L04",
      "name": "Citation Formatter",
      "description": "Format legal citations using Bluebook, OSCOLA or Indian citation formats",
      "type": "data_transform",
      "properties": {
        "citation_style": "Bluebook"
      },
      "icon": "book"
    },
    {
      "id": "tool-L05",
      "name": "Plagiarism Checker",
      "description": "Detect plagiarism in legal research papers or student assignments",
      "type": "analysis",
      "properties": {
        "threshold": 0.15
      },
      "icon": "shield"
    },
    {
      "id": "tool-L06",
      "name": "Case Law Summarizer",
      "description": "Summarize complex judgments into concise legal briefs",
      "type": "ai_model",
      "properties": {
        "summary_length": "short"
      },
      "icon": "clipboard"
    },
    {
      "id": "tool-L07",
      "name": "Email Notification",
      "description": "Send notifications to students, faculty, and administrators",
      "type": "notification",
      "properties": {
        "smtp_server": "smtp.jgls.edu"
      },
      "icon": "mail"
    },
    {
      "id": "tool-L08",
      "name": "Academic Database",
      "description": "Store course materials, case studies, and research papers",
      "type": "database",
      "properties": {
        "operation": "upsert"
      },
      "icon": "database"
    },
    {
      "id": "tool-L09",
      "name": "Legal Compliance Checker",
      "description": "Validate documents against regulatory frameworks",
      "type": "ai_model",
      "properties": {
        "frameworks": [
          "Companies Act",
          "Data Protection Act",
          "Corporate Governance"
        ]
      },
      "icon": "check"
    },
    {
      "id": "tool-L10",
      "name": "Web Legal Research",
      "description": "Search legal news, government circulars and regulatory updates",
      "type": "web_search",
      "properties": {
        "max_results": 10
      },
      "icon": "globe"
    }
  ],

  "agents": [
        {
      "id": "agent-start",
      "name": "Workflow Start",
      "description": "Entry point of the workflow. Configuration properties here are shared as read-only across all agents and tools in this workflow.",
      "type": "start",
      "tools": [],
      "properties": {
        "environment": "production",
        "version": "1.0.0",
        "timeout_seconds": 3600,
        "max_retries": 3,
        "run_label": ""
      },
      "icon": "play",
      "color": "#22c55e"
    },
    {
      "id": "agent-end",
      "name": "Workflow End",
      "description": "Exit point of the workflow. All agents and tools can write their final results here. Properties define the output schema for collected workflow data.",
      "type": "end",
      "tools": [],
      "properties": {
        "output_destination": "",
        "notify_on_complete": true,
        "archive_results": false,
        "summary": ""
      },
      "icon": "flag",
      "color": "#f43f5e"
    },
    {
      "id": "agent-L01",
      "name": "Legal Research Agent",
      "description": "Performs case law research and gathers legal references",
      "tools": ["tool-L01", "tool-L10"],
      "type": "automatic"
    },
    {
      "id": "agent-L02",
      "name": "Judgment Analysis Agent",
      "description": "Extracts key insights and legal principles from judgments",
      "tools": ["tool-L02", "tool-L06"],
      "type": "ai_agent"
    },
    {
      "id": "agent-L03",
      "name": "Legal Drafting Agent",
      "description": "Creates legal documents, contracts, and academic case briefs",
      "tools": ["tool-L03"],
      "type": "ai_agent"
    },
    {
      "id": "agent-L04",
      "name": "Citation Validation Agent",
      "description": "Ensures citations follow academic legal standards",
      "tools": ["tool-L04"],
      "type": "automatic"
    },
    {
      "id": "agent-L05",
      "name": "Plagiarism Detection Agent",
      "description": "Checks student submissions for originality",
      "tools": ["tool-L05"],
      "type": "automatic"
    },
    {
      "id": "agent-L06",
      "name": "Compliance Review Agent",
      "description": "Validates documents against regulatory frameworks",
      "tools": ["tool-L09"],
      "type": "ai_agent"
    },
    {
      "id": "agent-L07",
      "name": "Faculty Approval Agent",
      "description": "Routes research or legal drafts for faculty approval",
      "tools": ["tool-L07"],
      "type": "human_in_the_loop"
    },
    {
      "id": "agent-L08",
      "name": "Academic Repository Agent",
      "description": "Stores approved documents and research outputs",
      "tools": ["tool-L08"],
      "type": "automatic"
    },
    {
      "id": "agent-L09",
      "name": "Student Notification Agent",
      "description": "Notifies students about results, feedback or updates",
      "tools": ["tool-L07"],
      "type": "automatic"
    },
    {
      "id": "agent-L10",
      "name": "Workflow Coordinator",
      "description": "Coordinates multiple legal education processes",
      "tools": ["tool-L07"],
      "type": "orchestrator"
    },
    {
      "id": "agent-007",
      "name": "Workflow Orchestrator",
      "description": "Routes execution based on conditions and triggers downstream webhooks",
      "type": "conditional",
      "tools": ["tool-010", "tool-001"],
      "properties": {"condition_field": "", "condition_operator": "equals", "condition_value": ""},
      "icon": "git-branch",
      "color": "#f97316"
    },
    {
      "id": "agent-008",
      "name": "Parallel Executor",
      "description": "Runs multiple sub-tasks concurrently to reduce total execution time",
      "type": "parallel",
      "tools": ["tool-001", "tool-002"],
      "properties": {"max_concurrency": 4, "merge_strategy": "combine"},
      "icon": "layers",
      "color": "#a855f7"
    },
    {
      "id": "agent-009",
      "name": "Role-Based Approver",
      "description": "Routes tasks to role-specific approvers based on business rules",
      "type": "role_based",
      "tools": ["tool-007", "tool-003"],
      "properties": {"roles": ["manager", "compliance"], "require_all": false},
      "icon": "users",
      "color": "#10b981"
    },
    {
      "id": "agent-010",
      "name": "Prompt Agent",
      "description": "Executes parameterized System + User prompt templates against an LLM with variable injection",
      "type": "prompt_agent",
      "tools": ["tool-006", "tool-011"],
      "properties": {
        "system_prompt": "You are an expert {{domain}} analyst with deep knowledge of {{context}}.\n\nRespond in {{output_format}} format.\nBe concise, accurate, and data-driven.\nIf data is missing, clearly state assumptions.\nCurrent date: {{timestamp}}.",
        "user_prompt": "Input data:\n{{input_data}}\n\nTask: {{task}}\n\nProvide:\n1. A concise summary\n2. Key insights from the data\n3. Anomalies or risks detected\n4. Recommended next steps",
        "model": "llama-3.3-70b-versatile",
        "temperature": 0.7,
        "max_tokens": 2000,
        "output_format": "markdown"
      },
      "icon": "message-circle",
      "color": "#ec4899"
    },
    {
      "id": "agent-011",
      "name": "ReAct Agent",
      "description": "Iteratively Reasons and Acts using tools until a final answer is reached (ReAct pattern)",
      "type": "react_agent",
      "tools": ["tool-006", "tool-013", "tool-011"],
      "properties": {
        "goal_prompt": "Goal: {{user_query}}\n\nAvailable context:\n{{context}}\n\nInstructions:\n- Think step-by-step before each action\n- Use Web Search to find recent information\n- Use REST API Caller for structured data retrieval\n- Cite your sources in the final answer\n- Stop reasoning when you reach a confident answer\n- Format final answer as: {{output_format}}",
        "max_iterations": 6,
        "model": "llama-3.3-70b-versatile",
        "stop_on_answer": true,
        "trace_thoughts": true
      },
      "icon": "repeat",
      "color": "#06b6d4"
    },
    {
      "id": "agent-012",
      "name": "Reflection Agent",
      "description": "Generates an initial output, self-critiques it and iteratively improves until quality threshold is met",
      "type": "reflection_agent",
      "tools": ["tool-006"],
      "properties": {
        "critique_prompt": "Review the following response:\n---\n{{previous_output}}\n---\n\nEvaluate on three dimensions:\n1. Accuracy — Is every factual claim correct? (1–10)\n2. Completeness — Does it fully address the original task? (1–10)\n3. Clarity — Is it well-structured and easy to understand? (1–10)\n\nProvide:\n- An overall score (average of the three)\n- Specific weaknesses found\n- Concrete, actionable improvements\n- A revised version if score < {{quality_threshold}}",
        "quality_threshold": 8.0,
        "max_iterations": 3,
        "model": "llama-3.3-70b-versatile",
        "temperature": 0.4
      },
      "icon": "refresh-cw",
      "color": "#14b8a6"
    },
    {
      "id": "agent-013",
      "name": "Guardrails Agent",
      "description": "Validates and sanitizes inputs/outputs against safety rules, PII detection and schema constraints",
      "type": "guardrails",
      "tools": ["tool-002"],
      "properties": {
        "check_pii": true,
        "check_toxicity": true,
        "max_content_length": 4096,
        "block_on_violation": true,
        "redact_pii": true
      },
      "icon": "shield",
      "color": "#ef4444"
    },
    {
      "id": "agent-014",
      "name": "Orchestrator",
      "description": "Decomposes complex tasks, dispatches sub-tasks to specialist agents and merges results",
      "type": "orchestrator",
      "tools": ["tool-010", "tool-001"],
      "properties": {
        "decomposition_strategy": "llm",
        "merge_strategy": "reduce",
        "max_sub_agents": 5,
        "timeout_seconds": 120,
        "model": "llama-3.3-70b-versatile"
      },
      "icon": "network",
      "color": "#7c3aed"
    },
    {
      "id": "agent-015",
      "name": "Supervisor",
      "description": "Monitors agent health, routes tasks by policy, catches failures and triggers retries or escalations",
      "type": "supervisor",
      "tools": ["tool-008", "tool-003"],
      "properties": {
        "routing_policy": "round_robin",
        "max_retries": 3,
        "failure_threshold": 2,
        "escalation_channel": "#ops-alerts",
        "heartbeat_interval_s": 10
      },
      "icon": "monitor",
      "color": "#84cc16"
    }
  ],

